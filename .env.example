# Copy this file to .env and fill it in one value at a time as the workbook
# tells you where each one comes from. Gradle reads .env when it starts the
# app (./gradlew bootRun) and when it renders the assistant configs
# (./gradlew configure). Never commit .env.

# Part 1. The Unleash instance you sign in to: everything in the address bar
# before /projects, with no trailing slash and no /api.
UNLEASH_URL=

# Part 1. Backend token for your project, development environment. Created
# under your project > Settings > API access. Looks like
# your-project:development.xxxxxxxx
UNLEASH_BACKEND_TOKEN=

# Part 4. Personal access token for the Unleash MCP server your assistant
# talks to. Created under your profile > Personal API tokens. Starts with
# user:
UNLEASH_PAT=

# Optional. Seconds between metric reports to Unleash, including impact
# metrics. Low so Ick taps reach a safeguard within seconds.
UNLEASH_METRICS_INTERVAL_SECONDS=5
