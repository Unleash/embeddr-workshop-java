# Copy this file to .env and fill in the four values. Gradle reads .env when
# it starts the app (./gradlew bootRun) and when it renders the assistant
# configs (./gradlew configure). Never commit .env.

# The Unleash instance you sign in to: everything in the address bar before
# /projects, with no trailing slash and no /api.
UNLEASH_URL=https://your-instance.getunleash.io

# Backend token for your project, development environment. Create it under
# your project > Settings > API access. It looks like
# your-project:development.xxxxxxxx
UNLEASH_BACKEND_TOKEN=

# Flag names are unique across the whole instance, so every flag this app
# evaluates is named <flag>-<suffix>. Use your project id, for example
# melinda-f. The code keeps using the short name; the wrapper adds the suffix.
UNLEASH_FLAG_SUFFIX=

# Personal access token for the Unleash MCP server your assistant talks to.
# Create it under your profile > Personal API tokens. It starts with user:
UNLEASH_PAT=

# Optional. Seconds between metric reports to Unleash, including impact
# metrics. Low so Ick taps reach a safeguard within seconds.
UNLEASH_METRICS_INTERVAL_SECONDS=5
